# ---------- Backend ----------
PORT=8080
NODE_ENV=development
# Origens permitidas (separe por vírgula). Use * apenas em desenvolvimento.
CORS_ORIGIN=http://localhost:5173

# ---------- Supabase (SOMENTE backend) ----------
# Connection string do Postgres do Supabase (Project Settings > Database > Connection string > URI)
# Ex.: postgresql://postgres.xxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Chave service_role (nunca exponha no frontend). Usada só para health/inicialização opcional.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Simulação ----------
WORLD_SEED=20261121
WORLD_ID=ant-life-1
AI_COLONIES=2           # colônias selvagens criadas junto com o mundo
PERSIST=auto            # auto | postgres | file | memory
PERSIST_INTERVAL_MS=30000
SNAPSHOT_DIR=./data/snapshots
ADMIN_TOKEN=troque-isto
# Limites (veja docs/LIMITES.md antes de aumentar)
MAX_PLAYERS=120
MAX_DETAILED_ANTS=420
MAX_ANTS=2600
MAX_PREDATORS=90
LOG_LEVEL=info

# ---------- Frontend (VITE_* é exposto ao navegador) ----------
VITE_SERVER_URL=http://localhost:8080
