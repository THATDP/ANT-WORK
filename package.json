{
  "name": "ant-life",
  "private": true,
  "version": "1.0.0",
  "description": "ANT LIFE \u2014 simulador multiplayer de uma civiliza\u00e7\u00e3o de formigas em um mundo vivo",
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "install:all": "npm install",
    "dev": "node scripts/dev.mjs",
    "dev:backend": "npm --workspace backend run dev",
    "dev:frontend": "npm --workspace frontend run dev",
    "build": "npm --workspace frontend run build",
    "start": "npm --workspace backend run start",
    "migrate": "npm --workspace backend run migrate",
    "test": "npm --workspace backend test"
  }
}
